[user]
    name = Vital Wang
    email = vital.wang@hotmail.com
[init]
    defaultBranch = main
[credential]
    helper = cache
[push]
    autoSetupRemote = true
[pull]
    rebase = true
[merge]
    conflictStyle = zdiff3
[diff]
    colorMoved = zebra
    colorMovedWS = allow-indentation-change
[color "diff"]
    ; Dayfox color scheme
    ; lua pal = require('nightfox.palette').load("dayfox"); spec = require('nightfox.spec').load("dayfox"); C = require('nightfox.lib.color')
    ; lua print(C(spec.bg1):blend(C(pal.green.base), 0.2):to_css())
    old = "normal #e6c8c8"                 ; blend bg1 with red at 0.2
    new = "normal #d0d6cd"                 ; blend bg1 with green at 0.2
    oldMoved = "normal #e6cee3"            ; blend bg1 with pink at 0.2
    newMoved = "normal #cddad8"            ; blend bg1 with cyan at 0.2
    oldMovedAlternative = "normal #dbcce8" ; blend bg1 with magenta at 0.2
    newMovedAlternative = "normal #cdd0e0" ; blend bg1 with blue at 0.2

[core]
    pager = "command -v delta >/dev/null 2>&1 && delta || less"
[interactive]
    diffFilter = "command -v delta >/dev/null 2>&1 && delta --color-only || less"
[delta]
    syntax-theme = ansi
    navigate = true  # use n and N to move between diff sections
    light = true
    ; side-by-side = true

    ; generic color scheme
    ; minus-style = "syntax auto"
    ; minus-emph-style = "syntax auto"

    ; Dayfox color scheme
    minus-style = "syntax #e6c8c8"      ; blend bg1 with red at 0.2
    minus-emph-style = "syntax #d69fa2" ; blend bg1 with red at 0.4
    plus-style = "syntax #d0d6cd"       ; blend bg1 with green at 0.2
    plus-emph-style = "syntax #aabbab"  ; blend bg1 with green at 0.4

    line-numbers = false
    file-decoration-style = "green ul"
    file-style = "green bold"

[alias]
    lg = -c diff.external=difft log --ext-diff
    sh = -c diff.external=difft show --ext-diff
    df = -c diff.external=difft diff
    pf = push --force-with-lease
    claim = blame -M -C -C -C
    review = "!nvim -c \"DiffviewOpen origin/master... --imply-local\""
    s = "!emacsclient -nw --eval '(progn (magit-status) (delete-other-windows))'"
