#!/bin/bash

set -euo pipefail

PROBLEMS_FILE="${SIGASI_TSC_PROBLEMS_FILE:-${XDG_RUNTIME_DIR:-/tmp}/sigasi-tsc-problems}"
TEST_DEBUG_CONFIG="$VSCODE_EXTENSION_PATH/.vscode-test/debug-config.mjs"
TEST_PRELOAD="$VSCODE_EXTENSION_PATH/.vscode-test/source-map-support.cjs"
# `.vscode-test.mjs' puts the runner's VS Code state here.
TEST_USER_DATA_DIR="${TMPDIR:-/tmp}/svh-vscode-test"

SIGASI_REPO="$(dirname "$VSCODE_EXTENSION_PATH")"
SERVER_DIR="$VSCODE_EXTENSION_PATH/packages/buildUtils/dist/server"

yarn_watch_pids() {
    pgrep -f 'bin/yarn (compile:watch|watch:packages)$'
}

gradle_watch_pids() {
    pgrep -f 'gradle-wrapper\.jar --continuous assemble'
}

wait_until_watching() {
    local marker=$1 line
    while IFS= read -r line; do
        echo "$line"
        case $line in
            *"$marker"*)
                # Hand the pipe to a background drain before returning, otherwise the
                # watch dies of SIGPIPE on its next message.
                cat &>/dev/null &
                return 0
                ;;
        esac
    done
    return 1
}

# Parse `tsc --watch' output and publish problems to $PROBLEMS_FILE.
# One line per problem, TAB to separate the fields
publish_tsc_problems() {
    setsid --fork awk -v root="$PWD" -v dest="$PROBLEMS_FILE" '
        function publish(   i, tmp) {
            tmp = dest ".tmp"
            printf "" > tmp
            for (i = 1; i <= n; i++) print problems[i] > tmp
            close(tmp)
            system("mv -f " tmp " " dest)
        }
        { print; fflush() }
        / - (Starting compilation in watch mode|File change detected\. Starting incremental compilation)\.\.\./ {
            n = 0; next
        }
        match($0, /^([^ \t].*)\(([0-9]+),([0-9]+)\): (error|warning|info) TS([0-9]+): (.*)$/, m) {
            problems[++n] = m[4] "\t" root "/" m[1] "\t" m[2] "\t" m[3] "\tTS" m[5] "\t" m[6]
            next
        }
        / - (Compilation complete\.|Found [0-9]+ errors?\.) Watching for file changes\./ { publish() }
        END { n = 0; publish() }
    ' 2>&1
}

start_watchers() {
    if yarn_watch_pids >/dev/null; then
        echo "yarn watchers already running"
        return
    fi

    (
        cd "$VSCODE_EXTENSION_PATH"

        yarn install
        yarn build:dep
        # Without &>/dev/null the watcher writes to the terminal, or holds the caller's pipe open, after exit
        # Without </dev/null the watchers keep reading the terminal after exit
        setsid --fork yarn watch:packages </dev/null &>/dev/null
        setsid --fork yarn compile:watch </dev/null 2>&1 \
            | publish_tsc_problems \
            | wait_until_watching "Watching for file changes"
    )
}

start_gradle_watch() {
    if gradle_watch_pids >/dev/null; then
        echo "gradle watch already running"
        return
    fi

    echo "starting gradle watch"
    (
        cd "$SIGASI_REPO"

        # See start_watchers for </dev/null.
        setsid --fork ./gradlew --continuous \
            assemble \
            --offline </dev/null 2>&1 \
            | wait_until_watching "Waiting for changes to input files"
    )
}

kill_process_groups() {
    local what=$1 pid
    shift

    if [ $# -eq 0 ]; then
        echo "$what not running"
        return
    fi

    for pid in "$@"; do
        kill -INT "-$pid" 2>/dev/null || true
    done
}

stop_watchers() {
    echo "stopping watchers"
    kill_process_groups "gradle watch" $(gradle_watch_pids || true)
    kill_process_groups "yarn watchers" $(yarn_watch_pids || true)
    # awk empties the file when the pipe closes; do it here too in case it died.
    : >"$PROBLEMS_FILE" 2>/dev/null || true
}

# Gradle-compiled classes go in front of the assembled SDK jars, so an edit is live as soon as
# the watch has compiled it.
lsp_classpath() {
    local cp
    cp=$(ls -d "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/classes/java/main | tr '\n' ':')
    cp+=$(ls -d "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/resources/main \
                "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/bin-includes-resources 2>/dev/null \
          | grep -vE 'com\.sigasi\.hdt\.(core|logging)/target' | tr '\n' ':' || true)
    cp+="$SERVER_DIR/com.sigasi.hdt.toolchains.stubs"
    cp+=":$SERVER_DIR/com.sigasi.hdt.verilog.verible.natives"
    cp+=":$SERVER_DIR/com.sigasi.yourkit"
    cp+=":$SERVER_DIR/*"
    cp+=":$SERVER_DIR/com.sigasi.yourkit/lib/yjp-controller-api-redist.jar"
    echo "$cp"
}

start_lsp_server() {
    if [ ! -d "$SERVER_DIR" ]; then
        echo "No assembled server at $SERVER_DIR; run a full build first." >&2
        return 1
    fi

    java \
        -Dguice_bytecode_gen_option=DISABLED \
        --enable-native-access=ALL-UNNAMED \
        --sun-misc-unsafe-memory-access=allow \
        -Xmx8g -Xss4m -XX:+UseG1GC -XX:+EnableDynamicAgentLoading \
        -XX:G1PeriodicGCInterval=60000 -XX:-G1PeriodicGCInvokesConcurrent \
        -XX:MinHeapFreeRatio=5 -XX:MaxHeapFreeRatio=30 -XX:+UseStringDeduplication \
        -Dsigasi.dev.mode=true \
        -cp "$(lsp_classpath)" com.sigasi.lsp.server.LspServer "$@" &
    server_pid=$!
    echo "language server started (pid $server_pid)"
}

cmd_lsp_run() {
    (
        cd "$SIGASI_REPO"
        ./gradlew com.sigasi.lsp.server:classes processResources syncBinIncludesResources --offline
    )

    start_lsp_server "$@"

    # headless Chromium sets SIGINT to SIG_IGN
    trap 'kill -TERM "$server_pid" 2>/dev/null || true' INT TERM
    wait "$server_pid" || true
    wait "$server_pid"
}

problems() {
    cat "$PROBLEMS_FILE" 2>/dev/null || true
}

watcher_status() {
    if yarn_watch_pids >/dev/null; then
        echo "yarn watchers running"
    else
        echo "yarn watchers not running"
    fi

    if gradle_watch_pids >/dev/null; then
        echo "gradle watch running"
    else
        echo "gradle watch not running"
    fi
}

code_pids() {
    local data_dir=${1:-$VSCODE_DATA_DIR/user-data}
    pgrep -f "code .* --inspect(-brk|-port)?=.* --user-data-dir=$data_dir(\$| )"
}

vscode_dev_pids() {
    pgrep -f -- "--extensionDevelopmentPath=$VSCODE_EXTENSION_PATH .*--user-data-dir=$VSCODE_DATA_DIR/user-data"
}

get_pid() {
    local pid
    for _ in $(seq 20); do
        pid=$(code_pids "${1-}" | tail -1)
        [ -n "$pid" ] && break
        sleep 0.1
    done
    [ -n "$pid" ] || return 1
    echo "$pid"
}

get_port() {
    local pid=${1:-$(get_pid)} port
    [ -n "$pid" ] || return 1
    port=$(tr '\0' ' ' < "/proc/$pid/cmdline" | grep -oP -- '--inspect(-brk)?=[^ ]*:\K[0-9]+' || true)
    if [ -z "$port" ]; then                    # --inspect-port=0 -> activate, then read the socket
        kill -USR1 "$pid"                      # no-op once the inspector is open
        for _ in $(seq 20); do
            port=$(ss -Hltnp | grep -F "pid=$pid," | grep -oP ':\K[0-9]+(?=\s)' | head -1 || true)
            [ -n "$port" ] && break
            sleep 0.1
        done
    fi
    [ -n "$port" ] || return 1
    echo "$port"
}

print_inspector_port() {
    get_port || { echo "no port" >&2; return 1; }
}

emit_port() {
    get_port || echo "port none"
}

follow_inspector_port() {
    if [[ ! -f "$VSCODE_LOG_FILE" ]]; then
        echo "VS Code log file '$VSCODE_LOG_FILE' does not exist" >&2
        return 1
    fi

    emit_port

    # bash sets $! from a process substitution since 5.1
    exec 3< <(tail -n0 -f "$VSCODE_LOG_FILE" 2>/dev/null)
    local tail_pid=$!

    trap 'kill "$tail_pid" 2>/dev/null || true' EXIT
    trap 'exit' INT TERM

    while IFS= read -r line <&3; do
        case $line in
            *"Extension host with pid "*" exited"*)
                emit_port
                ;;
        esac
    done
}

launch_vscode() {
    # SIGASI_DEBUG_MODE makes the extension attach to the server on 5007 rather than start one of
    # its own from the assembled jars.
    local debug_mode=${1:-false} inspect=${2:---inspect-extensions=9229}

    RELOAD_ON_WATCH=true SIGASI_DEBUG_MODE="$debug_mode" \
        code --extensionDevelopmentPath="$VSCODE_EXTENSION_PATH" \
             --user-data-dir="$VSCODE_DATA_DIR/user-data" \
             --extensions-dir="$VSCODE_DATA_DIR/extensions" \
             "$inspect" --verbose &>"$VSCODE_LOG_FILE" &
    vscode_pid=$!
}

start_vscode() {
    if vscode_dev_pids >/dev/null; then
        echo "VS Code already running"
        return
    fi

    start_watchers
    launch_vscode false "$1"
}

start_with_lsp() {
    local inspect=$1 dead

    if vscode_dev_pids >/dev/null; then
        echo "VS Code is already running; stop it first" >&2
        return 1
    fi

    start_watchers
    start_gradle_watch

    server_pid=""
    vscode_pid=""

    # Deliberately leaves VS Code running: Ctrl+C here should not close the editor.
    trap 'kill -TERM "$server_pid" 2>/dev/null || true; exit 0' INT TERM

    start_lsp_server
    launch_vscode true "$inspect"

    while :; do
        dead=""
        wait -n -p dead || true
        # No children left, or the wait was interrupted.
        [ -n "$dead" ] || break

        case $dead in
            "$vscode_pid")
                echo "VS Code closed; stopping the language server"
                kill -TERM "$server_pid" 2>/dev/null || true
                break
                ;;
            "$server_pid")
                if ! kill -0 "$vscode_pid" 2>/dev/null; then
                    break
                fi
                echo "language server exited; restarting with the latest build"
                start_lsp_server
                ;;
        esac
    done
}

# Escape a literal title for use inside a JavaScript regular expression.
escape_regex() {
    printf '%s' "$1" | sed 's,[][\\^$.|?*+(){}/],\\&,g'
}

# The runner takes launch arguments from a configuration file only.
write_test_debug_config() {
    mkdir -p "${TEST_DEBUG_CONFIG%/*}"
    cat >"$TEST_DEBUG_CONFIG" <<EOF
// Generated by sigasi-dev; changes are overwritten.
import config from "file://$VSCODE_EXTENSION_PATH/.vscode-test.mjs"

export default {
    ...config,
    extensionDevelopmentPath: "$VSCODE_EXTENSION_PATH",
    launchArgs: [...(config.launchArgs ?? []), "--inspect-brk-extensions=9230"]
}
EOF
}

# Map stack frames back to TypeScript.
write_test_preload() {
    mkdir -p "${TEST_PRELOAD%/*}"
    cat >"$TEST_PRELOAD" <<'EOF'
// Generated by sigasi-dev; changes are overwritten.
require("source-map-support").install({ handleUncaughtExceptions: false })
EOF
}

# Test runs don't clean up their language server
test_server_pids() {
    pgrep -f -- "--data-location $TEST_USER_DATA_DIR/"
}

# Only the servers this run added, so a run in another terminal keeps its own.
reap_test_servers() {
    local before=$1 pid
    for pid in $(test_server_pids || true); do
        if ! grep -qxF "$pid" <<<"$before"; then
            kill "$pid" 2>/dev/null || true
        fi
    done
}

filter_test_output() {
    awk '
        {
            # Colour has to survive, so match on a copy without it.
            plain = $0
            gsub(/\033\[[0-9;]*m/, "", plain)
        }

        plain ~ /^\[/                                     { next }  # VS Code, Electron
        plain ~ /^\(node:[0-9]+\)|^\(Use `/               { next }  # node warnings
        plain ~ /Resolving version|Validated version|Found existing install/ { next }
        plain ~ /^Ignoring the error while validating workspace folder/      { next }
        plain ~ /^Started local extension host|^Loading development extension/ { next }
        plain ~ /^Settings Sync: |^Unknown channel: /     { next }
        plain ~ /^Sigasi Visual HDL Language Server |^Started language server|^The server started on port/ { next }

        # What is left of a dropped line is often a blank one.
        plain ~ /^$/ { if (blank++) next; print; fflush(); next }
                     { blank = 0; print; fflush() }
    '
}

# Run test $3 of source file $2, or all of the file's tests when no title is
# given.  $1 holds the extension host on its first line and announces the port
# to attach a debugger to.
run_tests() {
    local debug=$1 file title rel js args=() before runner status=0
    shift

    if [ $# -lt 1 ]; then
        echo "usage: sigasi-dev [ext] test [--debug] FILE [TITLE]" >&2
        return 1
    fi

    file=$(realpath -m "$1")
    title=${2:-}

    case $file in
        "$VSCODE_EXTENSION_PATH"/src/*) ;;
        *)
            echo "not a test source under $VSCODE_EXTENSION_PATH/src: $file" >&2
            return 1
            ;;
    esac

    # The runner executes compiled output, not typescript
    rel=${file#"$VSCODE_EXTENSION_PATH"/src/}
    js="$VSCODE_EXTENSION_PATH/app/${rel%.*}.js"

    if [ -n "$title" ]; then
        # Mocha matches a test by its full title: the titles of the enclosing
        # suites, then its own, joined with spaces.
        args+=(--grep "/^$(escape_regex "$title")\$/")
    fi

    start_watchers

    write_test_preload
    args+=(--file "$TEST_PRELOAD" --color)

    if $debug; then
        write_test_debug_config
        args+=(--config "$TEST_DEBUG_CONFIG")
    fi

    before=$(test_server_pids || true)

    # `--fail-zero': a title matching nothing is a failure rather than a green
    # run of no tests at all.
    (
        cd "$VSCODE_EXTENSION_PATH" \
            && exec ./node_modules/.bin/vscode-test --run "$js" --fail-zero "${args[@]}"
    ) &
    runner=$!

    if $debug; then
        local pid port=
        while [ -z "$port" ] && kill -0 "$runner" 2>/dev/null; do
            pid=$(get_pid "$TEST_USER_DATA_DIR") && port=$(get_port "$pid") || true
        done
        echo "inspect-port ${port:-none}"
    fi

    wait "$runner" || status=$?
    reap_test_servers "$before"
    return $status
}

usage() {
    cat >&2 <<'EOF'
usage: sigasi-dev COMMAND [ARGUMENT]...

  start [--debug] [--lsp] [--follow]
                         launch VS Code.  --debug holds the extension host on
                         its first line, --lsp runs the language server from
                         source and rebuilds it as you edit, --follow keeps
                         printing the inspector port as the host restarts
  stop                   stop every watch
  status                 report which watches are running

  ext watch              start the yarn watchers
  ext problems           print the problems the tsc watch last reported
  ext test [--debug] FILE [TITLE]
                         run a test file, or the one test with that title
  ext port [--follow]    print the inspector port of a running extension host,
                         with --follow again each time it restarts

  lsp run [ARGUMENT]...  build the language server and run it in the foreground
  lsp watch              rebuild the language server as its sources change

`ext' may be left out: `watch' means `ext watch'.
EOF
    return 2
}

cmd_start() {
    local debug=false with_lsp=false follow=false inspect

    while [ $# -gt 0 ]; do
        case $1 in
            --debug) debug=true ;;
            --lsp) with_lsp=true ;;
            --follow) follow=true ;;
            *) echo "unknown option: $1" >&2; return 2 ;;
        esac
        shift
    done

    if $with_lsp && $follow; then
        echo "--lsp and --follow both hold the foreground" >&2
        return 2
    fi

    if $debug; then
        inspect=--inspect-brk-extensions=9229
    else
        inspect=--inspect-extensions=9229
    fi

    if $with_lsp; then
        start_with_lsp "$inspect"
        return
    fi

    if ! $follow; then
        start_vscode "$inspect"
        return
    fi

    # keep stdout free for the port protocol
    start_vscode "$inspect" >&2
    follow_inspector_port
}

cmd_ext_test() {
    local debug=false

    if [ "${1-}" = --debug ]; then
        debug=true
        shift
    fi

    run_tests "$debug" "$@" 2>&1 | filter_test_output
}

cmd_ext_port() {
    case ${1-} in
        "") print_inspector_port ;;
        --follow) follow_inspector_port ;;
        *) echo "unknown option: $1" >&2; return 2 ;;
    esac
}

cmd_ext() {
    case ${1-} in
        watch) start_watchers ;;
        problems) problems ;;
        test) shift; cmd_ext_test "$@" ;;
        port) shift; cmd_ext_port "$@" ;;
        "") usage ;;
        *) echo "unknown command: $1" >&2; usage ;;
    esac
}

cmd_lsp() {
    case ${1-} in
        run) shift; cmd_lsp_run "$@" ;;
        watch) start_gradle_watch ;;
        "") usage ;;
        *) echo "unknown lsp command: $1" >&2; usage ;;
    esac
}

case ${1-} in
    ext) shift; cmd_ext "$@" ;;
    lsp) shift; cmd_lsp "$@" ;;
    start) shift; cmd_start "$@" ;;
    stop) stop_watchers ;;
    status) watcher_status ;;
    "") usage ;;
    # The extension is the common case, so `ext' may be left out.
    *) cmd_ext "$@" ;;
esac
