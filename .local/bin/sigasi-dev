#!/bin/bash

set -euo pipefail

: "${SIGASI_REPO_ROOT:?set SIGASI_REPO_ROOT to the Sigasi checkout}"

EXT_DIR="${SIGASI_EXTENSION_DIR:?set SIGASI_EXTENSION_DIR to the VS Code extension in the checkout}"
EXT_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sigasi-dev-host"
EXT_LOG_FILE="${XDG_RUNTIME_DIR:-/tmp}/sigasi-dev-host.log"
EXT_PROBLEMS_FILE="${XDG_RUNTIME_DIR:-/tmp}/sigasi-tsc-problems"
EXT_TEST_DEBUG_CONFIG="$EXT_DIR/.vscode-test/debug-config.mjs"
EXT_TEST_PRELOAD="$EXT_DIR/.vscode-test/source-map-support.cjs"
# `.vscode-test.mjs' puts the runner's VS Code state here.
EXT_TEST_USER_DATA_DIR="${TMPDIR:-/tmp}/svh-vscode-test"

LSP_PROBLEMS_FILE="${XDG_RUNTIME_DIR:-/tmp}/sigasi-javac-problems"
LSP_SERVER_DIR="$EXT_DIR/packages/sdkLin/dist/server"
LSP_TEST_INIT_SCRIPT="${XDG_RUNTIME_DIR:-/tmp}/sigasi-dev-test.gradle.kts"

ext_watch_pids() {
    pgrep -f 'bin/yarn (compile:watch|watch:all)$'
}

lsp_watch_pids() {
    pgrep -f 'gradle-wrapper\.jar --continuous .*assemble'
}

wait_until_watching() {
    local marker=$1 line
    while IFS= read -r line; do
        echo "$line"
        case $line in
            *"$marker"*)
                # Hand the pipe to a background drain before returning, otherwise the
                # watch dies of SIGPIPE on its next message.
                cat &>/dev/null &
                return 0
                ;;
        esac
    done
    return 1
}

# Parse `tsc --watch' output and publish problems to $EXT_PROBLEMS_FILE.
# One line per problem, TAB to separate the fields
ext_publish_problems() {
    setsid --fork awk -v root="$PWD" -v dest="$EXT_PROBLEMS_FILE" '
        function publish(   i, tmp) {
            tmp = dest ".tmp"
            printf "" > tmp
            for (i = 1; i <= n; i++) print problems[i] > tmp
            close(tmp)
            system("mv -f " tmp " " dest)
        }
        { print; fflush() }
        / - (Starting compilation in watch mode|File change detected\. Starting incremental compilation)\.\.\./ {
            n = 0; next
        }
        match($0, /^([^ \t].*)\(([0-9]+),([0-9]+)\): (error|warning|info) TS([0-9]+): (.*)$/, m) {
            problems[++n] = m[4] "\t" root "/" m[1] "\t" m[2] "\t" m[3] "\tTS" m[5] "\t" m[6]
            next
        }
        / - (Compilation complete\.|Found [0-9]+ errors?\.) Watching for file changes\./ { publish() }
        END { n = 0; publish() }
    ' 2>&1
}

# Parse the javac diagnostics in `gradlew --continuous' output and publish them to
# $LSP_PROBLEMS_FILE
# One line per problem, TAB to separate the fields
lsp_publish_problems() {
    setsid --fork awk -v dest="$LSP_PROBLEMS_FILE" '
        function publish(   i, tmp) {
            tmp = dest ".tmp"
            printf "" > tmp
            for (i = 1; i <= n; i++) print problems[i] > tmp
            close(tmp)
            system("mv -f " tmp " " dest)
        }
        function flush_pending() {
            if (state) problems[++n] = sev "\t" file "\t" line "\t" (col ? col : 1) "\tjavac\t" msg
            state = 0
        }
        { print; fflush() }
        # Each build is one batch: the first one, then one per detected change.
        NR == 1 || /^Change detected, executing build\.\.\./ { flush_pending(); n = 0; skip = 0 }
        # Gradle repeats the compiler output under "What went wrong"
        /^\* What went wrong:/ { flush_pending(); skip = 1 }
        /^BUILD (SUCCESSFUL|FAILED)/ { flush_pending(); skip = 0; publish(); next }
        skip { next }
        match($0, /^(\/[^:]+\.java):([0-9]+): (error|warning): (.*)$/, m) {
            flush_pending()
            file = m[1]; line = m[2]; sev = m[3]; msg = m[4]; col = 0
            gsub(/\t/, " ", msg)
            state = 1                       # next: the source line
            next
        }
        state == 1 { state = 2; next }      # the source line itself
        state == 2 && /^[ \t]*\^$/ {        # the caret, indented like the source
            col = index($0, "^"); state = 3; next
        }
        state == 3 && /^  [^ ]/ {           # required:, found:, reason:
            detail = $0; sub(/^ +/, "", detail); gsub(/\t/, " ", detail)
            msg = msg (msg ~ /;$/ ? " " : "; ") detail; next
        }
        { flush_pending() }
        END { n = 0; publish() }
    ' 2>&1
}

ext_start_watch() {
    if ext_watch_pids >/dev/null; then
        echo "yarn watchers already running"
        return
    fi

    (
        cd "$EXT_DIR"

        yarn install
        # Without &>/dev/null the watcher writes to the terminal, or holds the caller's pipe open, after exit
        # Without </dev/null the watchers keep reading the terminal after exit
        setsid --fork yarn watch:all </dev/null &>/dev/null
        setsid --fork yarn compile:watch </dev/null 2>&1 \
            | ext_publish_problems \
            | wait_until_watching "Watching for file changes"
    )
}

lsp_start_watch() {
    if lsp_watch_pids >/dev/null; then
        echo "gradle watch already running"
        return
    fi

    echo "starting gradle watch"
    (
        cd "$SIGASI_REPO_ROOT"

        # See ext_start_watch for </dev/null.
        setsid --fork ./gradlew --continuous --continue --console=plain \
            assemble </dev/null 2>&1 \
            | lsp_publish_problems \
            | wait_until_watching "Waiting for changes to input files"
    )
}

kill_process_groups() {
    local what=$1 pid
    shift

    if [ $# -eq 0 ]; then
        echo "$what not running"
        return
    fi

    for pid in "$@"; do
        kill -INT "-$pid" 2>/dev/null || true
    done
}

stop_watches() {
    echo "stopping watchers"
    kill_process_groups "gradle watch" $(lsp_watch_pids || true)
    kill_process_groups "yarn watchers" $(ext_watch_pids || true)
    # awk empties the files when the pipe closes; do it here too in case it died.
    : >"$EXT_PROBLEMS_FILE" 2>/dev/null || true
    : >"$LSP_PROBLEMS_FILE" 2>/dev/null || true
}

# Gradle-built module jars go in front of the assembled SDK jars, so an edit is live as soon as
# the watch has assembled it.  Jars rather than class folders: ResourceFetcher looks up a
# module's resource folder (wavedrom's lib/) on the classpath, and loose folders all share one
# namespace, so another module's lib/ would win.
lsp_classpath() {
    local cp
    cp=$(ls "$SIGASI_REPO_ROOT"/com.sigasi.*/build/libs/*.jar | tr '\n' ':')
    cp+="$LSP_SERVER_DIR/com.sigasi.hdt.toolchains.stubs"
    cp+=":$LSP_SERVER_DIR/com.sigasi.hdt.verilog.verible.natives"
    cp+=":$LSP_SERVER_DIR/com.sigasi.yourkit"
    cp+=":$LSP_SERVER_DIR/*"
    cp+=":$LSP_SERVER_DIR/com.sigasi.yourkit/lib/yjp-controller-api-redist.jar"
    echo "$cp"
}

lsp_start_server() {
    if [ ! -d "$LSP_SERVER_DIR" ]; then
        echo "No assembled server at $LSP_SERVER_DIR; run a full build first." >&2
        return 1
    fi

    java \
        -Dguice_bytecode_gen_option=DISABLED \
        --enable-native-access=ALL-UNNAMED \
        --sun-misc-unsafe-memory-access=allow \
        -Xmx8g -Xss4m -XX:+UseG1GC -XX:+EnableDynamicAgentLoading \
        -XX:G1PeriodicGCInterval=60000 -XX:-G1PeriodicGCInvokesConcurrent \
        -XX:MinHeapFreeRatio=5 -XX:MaxHeapFreeRatio=30 -XX:+UseStringDeduplication \
        -Dsigasi.dev.mode=true \
        -cp "$(lsp_classpath)" com.sigasi.lsp.server.LspServer "$@" &
    server_pid=$!
    echo "language server started (pid $server_pid)"
}

cmd_lsp_start() {
    (
        cd "$SIGASI_REPO_ROOT"
        ./gradlew assemble
    )

    lsp_start_server "$@"

    # headless Chromium sets SIGINT to SIG_IGN
    trap 'kill -TERM "$server_pid" 2>/dev/null || true' INT TERM
    wait "$server_pid" || true
    wait "$server_pid"
}

ext_print_problems() {
    cat "$EXT_PROBLEMS_FILE" 2>/dev/null || true
}

lsp_print_problems() {
    cat "$LSP_PROBLEMS_FILE" 2>/dev/null || true
}

print_watch_status() {
    if ext_watch_pids >/dev/null; then
        echo "yarn watchers running"
    else
        echo "yarn watchers not running"
    fi

    if lsp_watch_pids >/dev/null; then
        echo "gradle watch running"
    else
        echo "gradle watch not running"
    fi
}

ext_inspected_pids() {
    local data_dir=${1:-$EXT_DATA_DIR/user-data}
    pgrep -f "code .* --inspect(-brk|-port)?=.* --user-data-dir=$data_dir(\$| )"
}

ext_vscode_pids() {
    pgrep -f -- "--extensionDevelopmentPath=$EXT_DIR .*--user-data-dir=$EXT_DATA_DIR/user-data"
}

ext_inspected_pid() {
    local pid
    for _ in $(seq 20); do
        pid=$(ext_inspected_pids "${1-}" | tail -1)
        [ -n "$pid" ] && break
        sleep 0.1
    done
    [ -n "$pid" ] || return 1
    echo "$pid"
}

ext_inspector_port() {
    local pid=${1:-$(ext_inspected_pid)} port
    [ -n "$pid" ] || return 1
    port=$(tr '\0' ' ' < "/proc/$pid/cmdline" | grep -oP -- '--inspect(-brk)?=[^ ]*:\K[0-9]+' || true)
    if [ -z "$port" ]; then                    # --inspect-port=0 -> activate, then read the socket
        kill -USR1 "$pid"                      # no-op once the inspector is open
        for _ in $(seq 20); do
            port=$(ss -Hltnp | grep -F "pid=$pid," | grep -oP ':\K[0-9]+(?=\s)' | head -1 || true)
            [ -n "$port" ] && break
            sleep 0.1
        done
    fi
    [ -n "$port" ] || return 1
    echo "$port"
}

ext_print_port() {
    ext_inspector_port || { echo "no port" >&2; return 1; }
}

ext_emit_port() {
    ext_inspector_port || echo "port none"
}

ext_follow_port() {
    if [[ ! -f "$EXT_LOG_FILE" ]]; then
        echo "VS Code log file '$EXT_LOG_FILE' does not exist" >&2
        return 1
    fi

    ext_emit_port

    # bash sets $! from a process substitution since 5.1
    exec 3< <(tail -n0 -f "$EXT_LOG_FILE" 2>/dev/null)
    local tail_pid=$!

    trap 'kill "$tail_pid" 2>/dev/null || true' EXIT
    trap 'exit' INT TERM

    while IFS= read -r line <&3; do
        case $line in
            *"Extension host with pid "*" exited"*)
                ext_emit_port
                ;;
        esac
    done
}

ext_launch_vscode() {
    # SIGASI_DEBUG_MODE makes the extension attach to the server on 5007 rather than start one of
    # its own from the assembled jars.
    local debug_mode=${1:-false} inspect=${2:---inspect-extensions=9229}

    RELOAD_ON_WATCH=true SIGASI_DEBUG_MODE="$debug_mode" \
        code --extensionDevelopmentPath="$EXT_DIR" \
             --user-data-dir="$EXT_DATA_DIR/user-data" \
             --extensions-dir="$EXT_DATA_DIR/extensions" \
             "$inspect" --verbose &>"$EXT_LOG_FILE" &
    vscode_pid=$!
}

ext_start_vscode() {
    if ext_vscode_pids >/dev/null; then
        echo "VS Code already running"
        return
    fi

    ext_start_watch
    ext_launch_vscode false "$1"
}

start_vscode_with_lsp() {
    local inspect=$1 dead

    if ext_vscode_pids >/dev/null; then
        echo "VS Code is already running; stop it first" >&2
        return 1
    fi

    ext_start_watch
    lsp_start_watch

    server_pid=""
    vscode_pid=""

    # Deliberately leaves VS Code running: Ctrl+C here should not close the editor.
    trap 'kill -TERM "$server_pid" 2>/dev/null || true; exit 0' INT TERM

    lsp_start_server
    ext_launch_vscode true "$inspect"

    while :; do
        dead=""
        wait -n -p dead || true
        # No children left, or the wait was interrupted.
        [ -n "$dead" ] || break

        case $dead in
            "$vscode_pid")
                echo "VS Code closed; stopping the language server"
                kill -TERM "$server_pid" 2>/dev/null || true
                break
                ;;
            "$server_pid")
                if ! kill -0 "$vscode_pid" 2>/dev/null; then
                    break
                fi
                echo "language server exited; restarting with the latest build"
                lsp_start_server
                ;;
        esac
    done
}

# Escape a literal title for use inside a JavaScript regular expression.
escape_regex() {
    printf '%s' "$1" | sed 's,[][\\^$.|?*+(){}/],\\&,g'
}

# The runner takes launch arguments from a configuration file only.
ext_write_test_debug_config() {
    mkdir -p "${EXT_TEST_DEBUG_CONFIG%/*}"
    cat >"$EXT_TEST_DEBUG_CONFIG" <<EOF
// Generated by sigasi-dev; changes are overwritten.
import config from "file://$EXT_DIR/.vscode-test.mjs"

export default {
    ...config,
    extensionDevelopmentPath: "$EXT_DIR",
    launchArgs: [...(config.launchArgs ?? []), "--inspect-brk-extensions=9230"]
}
EOF
}

# Map stack frames back to TypeScript.
ext_write_test_preload() {
    mkdir -p "${EXT_TEST_PRELOAD%/*}"
    cat >"$EXT_TEST_PRELOAD" <<'EOF'
// Generated by sigasi-dev; changes are overwritten.
require("source-map-support").install({ handleUncaughtExceptions: false })
EOF
}

# Test runs don't clean up their language server
ext_test_server_pids() {
    pgrep -f -- "--data-location $EXT_TEST_USER_DATA_DIR/"
}

# Only the servers this run added, so a run in another terminal keeps its own.
ext_reap_test_servers() {
    local before=$1 pid
    for pid in $(ext_test_server_pids || true); do
        if ! grep -qxF "$pid" <<<"$before"; then
            kill "$pid" 2>/dev/null || true
        fi
    done
}

ext_filter_test_output() {
    awk '
        {
            # Colour has to survive, so match on a copy without it.
            plain = $0
            gsub(/\033\[[0-9;]*m/, "", plain)
        }

        plain ~ /^\[/                                     { next }  # VS Code, Electron
        plain ~ /^\(node:[0-9]+\)|^\(Use `/               { next }  # node warnings
        plain ~ /Resolving version|Validated version|Found existing install/ { next }
        plain ~ /^Ignoring the error while validating workspace folder/      { next }
        plain ~ /^Started local extension host|^Loading development extension/ { next }
        plain ~ /^Settings Sync: |^Unknown channel: /     { next }
        plain ~ /^Sigasi Visual HDL Language Server |^Started language server|^The server started on port/ { next }

        # What is left of a dropped line is often a blank one.
        plain ~ /^$/ { if (blank++) next; print; fflush(); next }
                     { blank = 0; print; fflush() }
    '
}

# Run test $3 of source file $2, or all of the file's tests when no title is
# given.  $1 holds the extension host on its first line and announces the port
# to attach a debugger to.
ext_run_tests() {
    local debug=$1 file title rel js args=() before runner status=0
    shift

    if [ $# -lt 1 ]; then
        echo "usage: sigasi-dev [ext] test [--debug] FILE [TITLE]" >&2
        return 1
    fi

    file=$(realpath -m "$1")
    title=${2:-}

    case $file in
        "$EXT_DIR"/src/*) ;;
        *)
            echo "not a test source under $EXT_DIR/src: $file" >&2
            return 1
            ;;
    esac

    # The runner executes compiled output, not typescript
    rel=${file#"$EXT_DIR"/src/}
    js="$EXT_DIR/app/${rel%.*}.js"

    if [ -n "$title" ]; then
        # Mocha matches a test by its full title: the titles of the enclosing
        # suites, then its own, joined with spaces.
        args+=(--grep "/^$(escape_regex "$title")\$/")
    fi

    ext_start_watch

    ext_write_test_preload
    args+=(--file "$EXT_TEST_PRELOAD" --color)

    if $debug; then
        ext_write_test_debug_config
        args+=(--config "$EXT_TEST_DEBUG_CONFIG")
    fi

    before=$(ext_test_server_pids || true)

    # `--fail-zero': a title matching nothing is a failure rather than a green
    # run of no tests at all.
    (
        cd "$EXT_DIR" \
            && exec ./node_modules/.bin/vscode-test --run "$js" --fail-zero "${args[@]}"
    ) &
    runner=$!

    if $debug; then
        local pid port=
        while [ -z "$port" ] && kill -0 "$runner" 2>/dev/null; do
            pid=$(ext_inspected_pid "$EXT_TEST_USER_DATA_DIR") && port=$(ext_inspector_port "$pid") || true
        done
        echo "debug-port ${port:-none}"
    fi

    wait "$runner" || status=$?
    ext_reap_test_servers "$before"
    return $status
}

# Gradle only reports failing tests.  Report every test and a summary, at quiet
# level so that `-q' can keep the rest of the build out of the way.
lsp_write_test_init_script() {
    cat >"$LSP_TEST_INIT_SCRIPT" <<'EOF'
// Generated by sigasi-dev; changes are overwritten.
allprojects {
    tasks.withType<Test>().configureEach {
        testLogging {
            quiet {
                events("passed", "skipped", "failed")
                exceptionFormat = org.gradle.api.tasks.testing.logging.TestExceptionFormat.FULL
            }
        }
        val log = logger
        afterSuite(KotlinClosure2<TestDescriptor, TestResult, Unit>({ suite, result ->
            if (suite.parent == null) {
                log.quiet("${result.successfulTestCount} passed, ${result.failedTestCount} failed, " +
                    "${result.skippedTestCount} skipped")
            }
        }))
    }
}
EOF
}

# Run test $3 of Java source file $2, a method or a nested class, or all of the
# class's tests when no title is given.  $1 holds the test JVM until a debugger
# attaches, and announces the port to attach to.
lsp_run_tests() {
    local debug=$1 file title rel module src class filter part args=()
    shift

    if [ $# -lt 1 ]; then
        echo "usage: sigasi-dev lsp test [--debug] FILE [[NESTED.]METHOD]" >&2
        return 1
    fi

    file=$(realpath -m "$1")
    title=${2:-}

    rel=${file#"$SIGASI_REPO_ROOT"/}
    module=${rel%%/*}
    src=${rel#"$module"/}

    case $file:$src in
        "$SIGASI_REPO_ROOT"/*.java:src/*) ;;
        *)
            echo "not a Java source under $SIGASI_REPO_ROOT/MODULE/src: $file" >&2
            return 1
            ;;
    esac

    if [ ! -f "$SIGASI_REPO_ROOT/$module/build.gradle.kts" ]; then
        echo "not a Gradle module: $SIGASI_REPO_ROOT/$module" >&2
        return 1
    fi

    # Test modules keep their sources in src/; annotations2.processor is the
    # one with a conventional src/test/java/.
    src=${src#src/test/java/}
    src=${src#src/}
    class=${src%.java}
    class=${class//\//.}

    # TITLE names nested classes the way Java does, Outer.Nested, but Gradle
    # only matches their binary name, Outer$Nested.  Classes are capitalised,
    # methods are not.
    filter=$class
    for part in ${title//./ }; do
        case $part in
            [[:upper:]]*) filter+="\$$part" ;;
            *) filter+=".$part" ;;
        esac
    done

    lsp_write_test_init_script
    # `--rerun': an up-to-date test task runs nothing and reports nothing.
    args+=(--tests "$filter" --rerun --init-script "$LSP_TEST_INIT_SCRIPT")

    if $debug; then
        args+=(--debug-jvm)
    fi

    # A filter matching nothing already fails the build, like `--fail-zero'.
    (
        cd "$SIGASI_REPO_ROOT" \
            && exec ./gradlew -q --console=colored ":$module:test" "${args[@]}"
    )
}

usage() {
    cat >&2 <<'EOF'
usage: sigasi-dev COMMAND [ARGUMENT]...

  start [--debug] [--lsp] [--follow]
                         launch VS Code.  --debug holds the extension host on
                         its first line, --lsp runs the language server from
                         source and rebuilds it as you edit, --follow keeps
                         printing the inspector port as the host restarts
  stop                   stop every watch
  status                 report which watches are running

  ext watch              start the yarn watchers
  ext problems           print the problems the tsc watch last reported
  ext test [--debug] FILE [TITLE]
                         run a test file, or the one test with that title
  ext port [--follow]    print the inspector port of a running extension host,
                         with --follow again each time it restarts

  lsp start [ARGUMENT]...
                         build the language server and run it in the foreground
  lsp watch              rebuild the language server as its sources change
  lsp problems           print the javac problems the gradle watch last reported
  lsp test [--debug] FILE [[NESTED.]METHOD]
                         run a test class, or one of its nested classes or test
                         methods.  --debug holds the test JVM until a debugger
                         attaches to the port it reports

`ext' may be left out: `watch' means `ext watch'.
EOF
    return 2
}

cmd_start() {
    local debug=false with_lsp=false follow=false inspect

    while [ $# -gt 0 ]; do
        case $1 in
            --debug) debug=true ;;
            --lsp) with_lsp=true ;;
            --follow) follow=true ;;
            *) echo "unknown option: $1" >&2; return 2 ;;
        esac
        shift
    done

    if $with_lsp && $follow; then
        echo "--lsp and --follow both hold the foreground" >&2
        return 2
    fi

    if $debug; then
        inspect=--inspect-brk-extensions=9229
    else
        inspect=--inspect-extensions=9229
    fi

    if $with_lsp; then
        start_vscode_with_lsp "$inspect"
        return
    fi

    if ! $follow; then
        ext_start_vscode "$inspect"
        return
    fi

    # keep stdout free for the port protocol
    ext_start_vscode "$inspect" >&2
    ext_follow_port
}

# Gradle's own announcement, in the form `ext test' uses.
lsp_announce_debug_port() {
    sed -u 's/^Listening for transport dt_socket at address: \([0-9]*\)$/debug-port \1/'
}

# `ext test' and `lsp test'.  With --debug, both print `debug-port N' once the
# code under test waits for a debugger on port N.
cmd_test() {
    local kind=$1 debug=false
    shift

    if [ "${1-}" = --debug ]; then
        debug=true
        shift
    fi

    case $kind in
        ext) ext_run_tests "$debug" "$@" 2>&1 | ext_filter_test_output ;;
        lsp) lsp_run_tests "$debug" "$@" 2>&1 | lsp_announce_debug_port ;;
    esac
}

cmd_ext_port() {
    case ${1-} in
        "") ext_print_port ;;
        --follow) ext_follow_port ;;
        *) echo "unknown option: $1" >&2; return 2 ;;
    esac
}

cmd_ext() {
    case ${1-} in
        watch) ext_start_watch ;;
        problems) ext_print_problems ;;
        test) shift; cmd_test ext "$@" ;;
        port) shift; cmd_ext_port "$@" ;;
        "") usage ;;
        *) echo "unknown command: $1" >&2; usage ;;
    esac
}

cmd_lsp() {
    case ${1-} in
        start) shift; cmd_lsp_start "$@" ;;
        watch) lsp_start_watch ;;
        problems) lsp_print_problems ;;
        test) shift; cmd_test lsp "$@" ;;
        "") usage ;;
        *) echo "unknown lsp command: $1" >&2; usage ;;
    esac
}

case ${1-} in
    ext) shift; cmd_ext "$@" ;;
    lsp) shift; cmd_lsp "$@" ;;
    start) shift; cmd_start "$@" ;;
    stop) stop_watches ;;
    status) print_watch_status ;;
    "") usage ;;
    # The extension is the common case, so `ext' may be left out.
    *) cmd_ext "$@" ;;
esac
