#!/bin/bash

set -euo pipefail

PROBLEMS_FILE="${SIGASI_TSC_PROBLEMS_FILE:-${XDG_RUNTIME_DIR:-/tmp}/sigasi-tsc-problems}"
TEST_DEBUG_CONFIG="$VSCODE_EXTENSION_PATH/.vscode-test/debug-config.mjs"
TEST_PRELOAD="$VSCODE_EXTENSION_PATH/.vscode-test/source-map-support.cjs"
# `.vscode-test.mjs' puts the runner's VS Code state here.
TEST_USER_DATA_DIR="${TMPDIR:-/tmp}/svh-vscode-test"
TEST_LOG="${XDG_RUNTIME_DIR:-/tmp}/sigasi-test.log"
TEST_DEBUG=false

SIGASI_REPO="$(dirname "$VSCODE_EXTENSION_PATH")"
SERVER_DIR="$VSCODE_EXTENSION_PATH/packages/buildUtils/dist/server"
GRADLE_WATCH_PATTERN='gradle-wrapper\.jar --continuous com\.sigasi\.lsp\.server:classes'

# Turn `tsc --watch' output into one TAB-separated problem per line, the way
# VS Code's $tsc-watch problem matcher does
TSC_PROBLEMS_AWK='
function publish(   i, tmp) {
    tmp = dest ".tmp"
    printf "" > tmp
    for (i = 1; i <= n; i++) print problems[i] > tmp
    close(tmp)
    system("mv -f " tmp " " dest)
}
{ print; fflush() }
/ - (Starting compilation in watch mode|File change detected\. Starting incremental compilation)\.\.\./ {
    n = 0; next
}
match($0, /^([^ \t].*)\(([0-9]+),([0-9]+)\): (error|warning|info) TS([0-9]+): (.*)$/, m) {
    problems[++n] = m[4] "\t" root "/" m[1] "\t" m[2] "\t" m[3] "\tTS" m[5] "\t" m[6]
    next
}
/ - (Compilation complete\.|Found [0-9]+ errors?\.) Watching for file changes\./ { publish() }
END { n = 0; publish() }
'

start_watchers() {
    if pgrep -f 'bin/yarn (compile:watch|watch:packages)$' >/dev/null; then
        echo "watcher already running"
        return
    fi

    (
        cd "$VSCODE_EXTENSION_PATH"

        yarn install
        yarn build:dep
        setsid --fork yarn watch:packages 2>&1
        setsid --fork yarn compile:watch 2>&1 \
            | setsid --fork awk -v root="$PWD" -v dest="$PROBLEMS_FILE" "$TSC_PROBLEMS_AWK" \
            | (
            status=1
            while IFS= read -r line; do
                echo $line
                case $line in
                    *"Watching for file changes"*)
                        status=0; break ;;
                esac
            done

            # Hand the pipe to a background drain before leaving, otherwise the watcher
            # dies of SIGPIPE on its next recompile message.
            cat >/dev/null &

            exit $status
        )
    )
}

start_gradle_watch() {
    if pgrep -f "$GRADLE_WATCH_PATTERN" >/dev/null; then
        echo "gradle watch already running"
        return
    fi

    echo "starting gradle watch"
    (
        cd "$SIGASI_REPO"

        setsid --fork ./gradlew --continuous \
            com.sigasi.lsp.server:classes processResources syncBinIncludesResources \
            --offline 2>&1 \
            | (
            status=1
            while IFS= read -r line; do
                echo "$line"
                case $line in
                    *"Waiting for changes to input files"*)
                        status=0; break ;;
                esac
            done

            # Hand the pipe to a background drain before leaving, otherwise the watch
            # dies of SIGPIPE on its next rebuild message.
            cat >/dev/null &

            exit $status
        )
    )
}

stop_watchers() {
    echo "stopping watchers"
    pgrep -f "$GRADLE_WATCH_PATTERN" | xargs -r -I{} kill -INT -{}
    pgrep -f 'bin/yarn (compile:watch|watch:packages)$' | xargs -r -I{} kill -INT -{}
    # awk empties the file when the pipe closes; do it here too in case it died.
    : >"$PROBLEMS_FILE" 2>/dev/null || true
}

# Gradle-compiled classes go in front of the assembled SDK jars, so an edit is live as soon as
# the watch has compiled it.
lsp_classpath() {
    local cp
    cp=$(ls -d "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/classes/java/main | tr '\n' ':')
    cp+=$(ls -d "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/resources/main \
                "$SIGASI_REPO"/com.sigasi.*/target/gradle-out/bin-includes-resources 2>/dev/null \
          | grep -vE 'com\.sigasi\.hdt\.(core|logging)/target' | tr '\n' ':' || true)
    cp+="$SERVER_DIR/com.sigasi.hdt.toolchains.stubs"
    cp+=":$SERVER_DIR/com.sigasi.hdt.verilog.verible.natives"
    cp+=":$SERVER_DIR/com.sigasi.yourkit"
    cp+=":$SERVER_DIR/*"
    cp+=":$SERVER_DIR/com.sigasi.yourkit/lib/yjp-controller-api-redist.jar"
    echo "$cp"
}

start_lsp_server() {
    if [ ! -d "$SERVER_DIR" ]; then
        echo "No assembled server at $SERVER_DIR; run a full build first." >&2
        return 1
    fi

    java \
        -Dguice_bytecode_gen_option=DISABLED \
        --enable-native-access=ALL-UNNAMED \
        --sun-misc-unsafe-memory-access=allow \
        -Xmx8g -Xss4m -XX:+UseG1GC -XX:+EnableDynamicAgentLoading \
        -XX:G1PeriodicGCInterval=60000 -XX:-G1PeriodicGCInvokesConcurrent \
        -XX:MinHeapFreeRatio=5 -XX:MaxHeapFreeRatio=30 -XX:+UseStringDeduplication \
        -Dsigasi.dev.mode=true \
        -cp "$(lsp_classpath)" com.sigasi.lsp.server.LspServer "$@" &
    server_pid=$!
    echo "language server started (pid $server_pid)"
}

lsp_server() {
    (
        cd "$SIGASI_REPO"
        ./gradlew com.sigasi.lsp.server:classes processResources syncBinIncludesResources --offline
    )

    start_lsp_server "$@"

    # headless Chromium sets SIGINT to SIG_IGN
    trap 'kill -TERM "$server_pid" 2>/dev/null || true' INT TERM
    wait "$server_pid" || true
    wait "$server_pid"
}

problems() {
    cat "$PROBLEMS_FILE" 2>/dev/null || true
}

watcher_status() {
    if pgrep -f 'bin/yarn (compile:watch|watch:packages)$'; then
        echo "watchers running"
    else
        echo "watchers not running"
    fi

    if pgrep -f "$GRADLE_WATCH_PATTERN" >/dev/null; then
        echo "gradle watch running"
    else
        echo "gradle watch not running"
    fi
}

get_pid() {
    local data_dir=${1:-$VSCODE_DATA_DIR/user-data} pid
    for _ in $(seq 20); do
        pid=$(pgrep -f "code .* --inspect(-brk|-port)?=.* --user-data-dir=$data_dir(\$| )" | tail -1)
        [ -n "$pid" ] && break
        sleep 0.1
    done
    [ -n "$pid" ] || return 1
    echo $pid
}

get_port() {
    local pid=${1:-$(get_pid)} port
    [ -n "$pid" ] || return 1
    port=$(tr '\0' ' ' < "/proc/$pid/cmdline" | grep -oP -- '--inspect(-brk)?=[^ ]*:\K[0-9]+' || true)
    if [ -z "$port" ]; then                    # --inspect-port=0 -> activate, then read the socket
        kill -USR1 "$pid"                      # no-op once the inspector is open
        for _ in $(seq 20); do
            port=$(ss -Hltnp | grep -F "pid=$pid," | grep -oP ':\K[0-9]+(?=\s)' | head -1 || true)
            [ -n "$port" ] && break
            sleep 0.1
        done
    fi
    [ -n "$port" ] || return 1
    echo "$port"
}

attach() {
    local port
    if port=$(get_port); then
        echo "$port"
    else
        echo "no port" >&2
        return 1
    fi
}

emit_port() {
    local port
    if port=$(get_port); then
        echo "$port"
    else
        echo "port none"
    fi
}

listen_port() {
    if [[ ! -f "$VSCODE_LOG_FILE" ]]; then
        echo "VS Code log file '$VSCODE_LOG_FILE' does not exist" >&2
        exit 1
    fi

    emit_port

    exec 3< <(tail -n0 -f "$VSCODE_LOG_FILE" 2>/dev/null)
    local tail_pid=$!

    trap 'kill "$tail_pid" 2>/dev/null || true' EXIT
    trap 'exit' INT TERM

    while IFS= read -r line <&3; do
        case $line in
            # *"type: extensionHost, pid: "*"successfully created"*)
            #     ;;
            *"Extension host with pid "*" exited"*)
                emit_port
                ;;
        esac
    done
}

launch_vscode() {
    # SIGASI_DEBUG_MODE makes the extension attach to the server on 5007 rather than start one of
    # its own from the assembled jars.
    RELOAD_ON_WATCH=true SIGASI_DEBUG_MODE="${1:-false}" code --extensionDevelopmentPath="$VSCODE_EXTENSION_PATH" --user-data-dir="$VSCODE_DATA_DIR/user-data" --extensions-dir="$VSCODE_DATA_DIR/extensions" --inspect-extensions=9229 --verbose &>"$VSCODE_LOG_FILE" &
    vscode_pid=$!
}

vscode() {
    start_watchers

    if [ "${1-}" != "--server" ]; then
        launch_vscode false
        return
    fi

    start_gradle_watch

    local dead
    server_pid=""
    vscode_pid=""

    # Deliberately leaves VS Code running: Ctrl+C here should not close the editor.
    trap 'kill -TERM "$server_pid" 2>/dev/null || true; exit 0' INT TERM

    start_lsp_server
    launch_vscode true

    while :; do
        dead=""
        wait -n -p dead || true
        # No children left, or the wait was interrupted.
        [ -n "$dead" ] || break

        case $dead in
            "$vscode_pid")
                echo "VS Code closed; stopping the language server"
                kill -TERM "$server_pid" 2>/dev/null || true
                break
                ;;
            "$server_pid")
                if ! kill -0 "$vscode_pid" 2>/dev/null; then
                    break
                fi
                echo "language server exited; restarting with the latest build"
                start_lsp_server
                ;;
        esac
    done
}

vscode_debug() {
    start_watchers
    RELOAD_ON_WATCH=true code --extensionDevelopmentPath="$VSCODE_EXTENSION_PATH" --user-data-dir="$VSCODE_DATA_DIR/user-data" --extensions-dir="$VSCODE_DATA_DIR/extensions" --inspect-brk-extensions=9229 --verbose &>"$VSCODE_LOG_FILE" &
}

vscode_debug_inspect() {
    if pgrep -f -- "--extensionDevelopmentPath=$VSCODE_EXTENSION_PATH .*--user-data-dir=$VSCODE_DATA_DIR/user-data"; then
        echo "VS Code already running" >&2
    else
        # Keep stdout free for the port protocol
        vscode_debug >&2
    fi

    listen_port
}

# Escape a literal title for use inside a JavaScript regular expression.
escape_regex() {
    printf '%s' "$1" | sed 's,[][\\^$.|?*+(){}/],\\&,g'
}

# The runner takes launch arguments from a configuration file only.
write_test_debug_config() {
    mkdir -p "${TEST_DEBUG_CONFIG%/*}"
    cat >"$TEST_DEBUG_CONFIG" <<EOF
// Generated by sigasi-vscode; changes are overwritten.
import config from "file://$VSCODE_EXTENSION_PATH/.vscode-test.mjs"

export default {
    ...config,
    extensionDevelopmentPath: "$VSCODE_EXTENSION_PATH",
    launchArgs: [...(config.launchArgs ?? []), "--inspect-brk-extensions=9230"]
}
EOF
}

# Map stack frames back to TypeScript.
write_test_preload() {
    mkdir -p "${TEST_PRELOAD%/*}"
    cat >"$TEST_PRELOAD" <<'EOF'
// Generated by sigasi-vscode; changes are overwritten.
require("source-map-support").install({ handleUncaughtExceptions: false })
EOF
}

# Test runs don't clean up their language server
test_server_pids() {
    pgrep -f -- "--data-location $TEST_USER_DATA_DIR/" | tr '\n' ' ' || true
}

# Only the servers this run added, so a run in another terminal keeps its own.
reap_test_servers() {
    local before=$1 pid
    for pid in $(test_server_pids); do
        case " $before " in
            *" $pid "*) ;;
            *) kill "$pid" 2>/dev/null || true ;;
        esac
    done
}

filter_test_output() {
    awk -v logfile="$TEST_LOG" '
        {
            print > logfile
            fflush(logfile)
            # Colour has to survive, so match on a copy without it.
            plain = $0
            gsub(/\033\[[0-9;]*m/, "", plain)
        }

        plain ~ /^\[/                                     { next }  # VS Code, Electron
        plain ~ /^\(node:[0-9]+\)|^\(Use `/               { next }  # node warnings
        plain ~ /Resolving version|Validated version|Found existing install/ { next }
        plain ~ /^Ignoring the error while validating workspace folder/      { next }
        plain ~ /^Started local extension host|^Loading development extension/ { next }
        plain ~ /^Settings Sync: |^Unknown channel: /     { next }
        plain ~ /^Sigasi Visual HDL Language Server |^Started language server|^The server started on port/ { next }

        # What is left of a dropped line is often a blank one.
        plain ~ /^$/ { if (blank++) next; print; fflush(); next }
                     { blank = 0; print; fflush() }
    '
}

# Run test $2 of source file $1, or all of the file's tests when no title is
# given.  `test-debug' sets TEST_DEBUG, which holds the extension host on its
# first line and announces the port to attach a debugger to.
run_tests() {
    local file title rel js args=() before runner status=0

    if [ $# -lt 1 ]; then
        echo "usage: sigasi-vscode test|test-debug FILE [TITLE]" >&2
        return 1
    fi

    file=$(realpath -m "$1")
    title=${2:-}

    case $file in
        "$VSCODE_EXTENSION_PATH"/src/*) ;;
        *)
            echo "not a test source under $VSCODE_EXTENSION_PATH/src: $file" >&2
            return 1
            ;;
    esac

    # The runner executes compiled output, not typescript
    rel=${file#"$VSCODE_EXTENSION_PATH"/src/}
    js="$VSCODE_EXTENSION_PATH/app/${rel%.*}.js"

    if [ -n "$title" ]; then
        # Mocha matches a test by its full title: the titles of the enclosing
        # suites, then its own, joined with spaces.
        args+=(--grep "/^$(escape_regex "$title")\$/")
    fi

    start_watchers

    cd "$VSCODE_EXTENSION_PATH"

    write_test_preload
    args+=(--file "$TEST_PRELOAD" --color)

    if $TEST_DEBUG; then
        write_test_debug_config
        args+=(--config "$TEST_DEBUG_CONFIG")
    fi

    before=$(test_server_pids)

    # `--fail-zero': a title matching nothing is a failure rather than a green
    # run of no tests at all.
    ./node_modules/.bin/vscode-test --run "$js" --fail-zero "${args[@]}" &
    runner=$!

    if $TEST_DEBUG; then
        local pid port=
        while [ -z "$port" ] && kill -0 "$runner" 2>/dev/null; do
            pid=$(get_pid "$TEST_USER_DATA_DIR") && port=$(get_port "$pid") || true
        done
        echo "inspect-port ${port:-none}"
    fi

    wait "$runner" || status=$?
    reap_test_servers "$before"
    return $status
}

case $1 in
    watch) start_watchers ;;
    stop) stop_watchers ;;
    problems) problems ;;
    status) watcher_status ;;
    attach) attach ;;
    inspect) listen_port ;;
    start) shift; vscode "$@" ;;
    server) shift; lsp_server "$@" ;;
    debug) vscode_debug ;;
    debug-inspect) vscode_debug_inspect ;;
    test) shift; run_tests "$@" 2>&1 | filter_test_output ;;
    test-debug) shift; TEST_DEBUG=true; run_tests "$@" 2>&1 | filter_test_output ;;
esac
